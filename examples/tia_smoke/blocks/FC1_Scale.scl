FUNCTION "FC1_Scale" : Real
TITLE = Scale a raw analog value to percent
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
  Raw : Int;
END_VAR
VAR_TEMP
  Normalized : Real;
END_VAR
VAR CONSTANT
  RAW_MAX : Int := 27648;
END_VAR
BEGIN
  #Normalized := NORM_X(MIN := 0, VALUE := #Raw, MAX := #RAW_MAX);
  "FC1_Scale" := SCALE_X(MIN := 0.0, VALUE := #Normalized, MAX := 100.0);
END_FUNCTION
